# Uygulama
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_BRAND_NAME="Sarıyıldız"

# Veritabanı (PostgreSQL - Yerel veya Supabase/Neon)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sariyildiz_db?schema=public"

# Kimlik Doğrulama (Auth.js / NextAuth)
AUTH_SECRET="bir-gizli-rastgele-anahtar-en-az-32-karakter"
AUTH_URL="http://localhost:3000"
# Google OAuth (Opsiyonel)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Ödeme Sağlayıcıları (iyzico Sandbox)
IYZICO_API_KEY="sandbox-api-key"
IYZICO_SECRET_KEY="sandbox-secret-key"
IYZICO_BASE_URL="https://sandbox-api.iyzipay.com"

# E-posta (Resend veya SMTP)
RESEND_API_KEY=""
EMAIL_FROM="Sarıyıldız <bilgi@sariyildiz.com>"

# SMS (Opsiyonel)
SMS_PROVIDER="netgsm"
NETGSM_USERCODE=""
NETGSM_PASSWORD=""
NETGSM_HEADER="SARIYILDIZ"

# Önbellek & Hız Limiti (Redis - Opsiyonel / Geliştirmede memory fallback)
REDIS_URL="redis://localhost:6379"

# Medya Depolama (Cloudinary veya S3)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
